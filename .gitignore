# Segredos e certificados reais - nunca versionar
secrets/*
!secrets/.gitkeep
certs/*
!certs/.gitkeep
.env
# certs/tls/*.pem (certificado proprio da CA da prefeitura, se usado) ja
# cai em "certs/*" acima. Certificados do Let's Encrypt (modo producao com
# docker-compose.prod.yml) vivem no volume nomeado "traefik-certificates",
# fora do repositorio. O dynamic config gerado pelo setup.sh pra apontar
# pro certificado proprio tambem nao e' versionado (especifico do ambiente):
traefik/dynamic-certs/*.yml

# Backups locais
backups/
*.sql
*.sql.gz

# SO / editores
.DS_Store
Thumbs.db
