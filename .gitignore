# Segredos e certificados reais - nunca versionar
secrets/*
!secrets/.gitkeep
certs/*
!certs/.gitkeep
.env
# traefik/certs/ (certificado proprio do site, se usado - ver
# docs/scripts-referencia.md#traefik): a pasta em si fica versionada
# (com .gitkeep, mesmo padrao de secrets/ e certs/ acima), mas nem o
# certificado/chave reais nem o dynamic config gerado pelo setup.sh
# (especifico do ambiente). Certificados do Let's Encrypt (producao com
# docker-compose.prod.yml) vivem num volume nomeado, nem passam por aqui.
!traefik/certs/
traefik/certs/*
!traefik/certs/.gitkeep

# Backups locais
backups/
*.sql
*.sql.gz

# SO / editores
.DS_Store
Thumbs.db
